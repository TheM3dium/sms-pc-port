+			    = unk10->getModel()->getModelData()->getShapeNodePointer(0);
+			if (prompt)
+				face->onFlag(J3DShpFlag_Visible);
+			else
+				face->offFlag(J3DShpFlag_Visible);
+		}
+#endif
 		unk10->perform(cue, graphics);
+#ifdef TARGET_PC
+		if (prompt)
+			TalkCursorDrawPrompt(unk10->getModel(), prompt);
+#endif
 	}
 }
 
