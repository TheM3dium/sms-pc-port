+	if (GXPC_ApplyWidescreen)
+		port_widescreen = GXPC_ApplyWidescreen();
+#endif
+#ifdef TARGET_PC
 	// BetterSunshineEngine (word at retail 0x802B7720): a nop replaces this
 	// call (its initStageCallbacks, which calls setupObjects, resets first).
 	if (SMS_MOD_WORD(0x802B7720, 0) != 0x60000000)
@@ -396,6 +411,9 @@
 #endif
 		cam->mAspect = (u16)SMSGetGameVideoWidth() * 0.91346145f
